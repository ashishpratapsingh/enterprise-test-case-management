# Enterprise Test Case Management — environment template
#
# Copy this file to `.env` (at the backend working directory) and fill
# in real values. The backend loads `.env` via pydantic-settings at boot.
#
# -----------------------------------------------------------------------
# REQUIRED in production (DEBUG=false). The app will refuse to start
# if SECRET_KEY looks like a placeholder or is shorter than 32 chars.
# Generate one with:
#   openssl rand -hex 32
# -----------------------------------------------------------------------

# --- Application ---
DEBUG=false
# PROJECT_NAME=Enterprise Test Case Management
# API_V1_PREFIX=/api/v1

# --- Database ---
# SQLite (dev):      sqlite+aiosqlite:///./tcm.db
# Postgres (prod):   postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://tcm_user:tcm_pass@db:5432/tcm_db

# --- Authentication ---
# Required. MUST NOT be the placeholder. Generate: openssl rand -hex 32
SECRET_KEY=
# Defaults are fine for most deployments.
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# --- Rate limiting ---
# Per-IP token bucket. Bypassed entirely when DEBUG=true.
# RATE_LIMIT_PER_MINUTE=60

# --- External integrations (optional — leave blank if unused) ---
JIRA_BASE_URL=
JIRA_API_TOKEN=
BITBUCKET_BASE_URL=
BITBUCKET_API_TOKEN=

# --- Logging ---
# LOG_LEVEL=INFO
# LOG_FILE=logs/app.log
