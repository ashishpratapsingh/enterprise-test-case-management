# Enterprise Test Case Management — environment template
#
# Copy this file to `.env` (at the backend working directory) and fill
# in real values. The backend loads `.env` via pydantic-settings at boot.
#
# -----------------------------------------------------------------------
# REQUIRED in production (DEBUG=false). The app will refuse to start
# if SECRET_KEY looks like a placeholder or is shorter than 32 chars.
# Generate one with:
#   openssl rand -hex 32
# -----------------------------------------------------------------------

# --- Application ---
DEBUG=false
# PROJECT_NAME=Enterprise Test Case Management
# API_V1_PREFIX=/api/v1

# --- Database ---
# SQLite (dev):      sqlite+aiosqlite:///./tcm.db
# Postgres (prod):   postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://tcm_user:tcm_pass@db:5432/tcm_db

# --- Authentication ---
# Required. MUST NOT be the placeholder. Generate: openssl rand -hex 32
SECRET_KEY=
# Defaults are fine for most deployments.
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# --- Rate limiting ---
# Per-IP token bucket. Bypassed entirely when DEBUG=true.
# RATE_LIMIT_PER_MINUTE=60

# --- Email ---
# MAIL_BACKEND=console   : writes emails to the backend log. Default.
#                          The password-reset link shows up as a log line
#                          so local dev works without SMTP infra.
# MAIL_BACKEND=smtp      : real delivery via the SMTP server below.
MAIL_BACKEND=console
MAIL_FROM=noreply@tcm.local
# Public-facing URL used inside email links (e.g. password reset).
APP_BASE_URL=http://localhost:3000
# Only needed when MAIL_BACKEND=smtp:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# --- External integrations (optional — leave blank if unused) ---
#
# JIRA Cloud:    set JIRA_BASE_URL (https://your-org.atlassian.net),
#                JIRA_USER_EMAIL (the API token owner's account email),
#                and JIRA_API_TOKEN (generated at id.atlassian.com).
#                The app uses Basic auth (email:token) — required by Cloud.
#
# JIRA Server / DataCenter: set JIRA_BASE_URL and JIRA_API_TOKEN, leave
#                JIRA_USER_EMAIL blank — the app will use Bearer auth
#                with the Personal Access Token instead.
#
# JIRA_DEFAULT_PROJECT_KEY is purely a convenience: it pre-fills the
# project picker on the "Create JIRA issue" dialog.
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_DEFAULT_PROJECT_KEY=
BITBUCKET_BASE_URL=
BITBUCKET_API_TOKEN=

# GitHub:
# Leave GITHUB_BASE_URL blank for github.com (the app defaults to
# https://api.github.com). For GitHub Enterprise, set it to the API
# root, e.g. https://github.your-org.com/api/v3
# GITHUB_TOKEN is a Personal Access Token (classic or fine-grained)
# with at least ``repo:read`` scope.
# GITHUB_DEFAULT_REPO is "owner/repo" — pre-fills the repo picker.
GITHUB_BASE_URL=
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=

# --- Single Sign-On (OpenID Connect) ---
# Generic OIDC client — works with Okta, Azure AD, Google, Keycloak,
# Auth0, etc. Leave OIDC_* blank to disable SSO entirely (the login
# page hides the "Sign in with SSO" button automatically).
#
# Discovery URL is the IdP's well-known config — endpoints are
# auto-discovered from there:
#   Google      : https://accounts.google.com/.well-known/openid-configuration
#   Okta        : https://{your-org}.okta.com/.well-known/openid-configuration
#   Azure AD    : https://login.microsoftonline.com/{tenant_id}/v2.0/.well-known/openid-configuration
#   Keycloak    : https://{kc-host}/realms/{realm}/.well-known/openid-configuration
#
# OIDC_REDIRECT_URI must be whitelisted in the IdP. Leave blank to use
# {APP_BASE_URL}/api/v1/auth/sso/callback (recommended).
#
# OIDC_DEFAULT_ROLE_NAME controls auto-provisioning: when an unknown
# user signs in via SSO, they get auto-created with this role. Set to
# "" to require admins to pre-create accounts (SSO will reject
# never-seen-before users).
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_REDIRECT_URI=
OIDC_PROVIDER_NAME=SSO
OIDC_DEFAULT_ROLE_NAME=Viewer

# --- Sentry (error reporting) ---
# Leave SENTRY_DSN blank to disable Sentry entirely — the SDK is then
# never initialised, no outbound traffic, zero overhead. Set it to
# your project's DSN to turn on error + performance reporting.
#
# SENTRY_ENVIRONMENT tags every event so you can filter prod / staging
# / dev in the Sentry UI.
#
# SENTRY_TRACES_SAMPLE_RATE (0.0–1.0) controls performance-trace
# volume. 0.0 = errors only, 1.0 = trace every request. 0.1 is a
# sane prod default.
#
# SENTRY_RELEASE pins events to a build tag — typically your CI
# pipeline injects the git SHA here.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# --- Logging ---
# LOG_LEVEL=INFO
# LOG_FILE=logs/app.log
